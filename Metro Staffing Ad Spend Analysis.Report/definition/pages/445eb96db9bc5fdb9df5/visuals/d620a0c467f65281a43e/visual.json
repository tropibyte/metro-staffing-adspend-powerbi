        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What these three visuals say",
                    "textStyle": {
                      "fontSize": "11.0pt",
                      "color": "#2C5F8D",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "▪  ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#2C5F8D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Applications by category: Client Service delivered the most volume — 4,535 applications, 35.2% of the total — while consuming only 28.3% of the budget.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#16232E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "▪  ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#2C5F8D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Ad spend concentration: 94% of spend sits in just four categories, with Sales alone absorbing $16,707 (35.1%) of the month.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#16232E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "▪  ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#2C5F8D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Category scorecard: Sales costs $7.77 per application at a 6.5% apply rate, while Operations converts at 15.7% for $1.67 — the cheapest applications Metro Staffing bought all month, on 3.9% of the budget.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#16232E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#16232E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Why this matters to Metro Staffing:  ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#C0483F",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the same dollar buys four to five times more applications in Operations and Client Service than in Sales, so category-level bid caps rather than one account-wide budget would lift total applications without adding a dollar of spend.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#16232E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
